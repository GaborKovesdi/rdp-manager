<Window x:Class="RdpManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RdpManager"
        mc:Ignorable="d"
        Title="RDP Manager" Height="480" Width="820" MinHeight="320" MinWidth="560"
        Icon="pack://application:,,,/app.ico">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="ImportButton" Content="Importálás (.rdp)" Padding="10,5" Margin="0,0,6,0" Click="ImportButton_Click"/>
            <Button x:Name="AddButton" Content="Új kapcsolat" Padding="10,5" Margin="0,0,6,0" Click="AddButton_Click"/>
            <Button x:Name="EditButton" Content="Szerkesztés" Padding="10,5" Margin="0,0,6,0" Click="EditButton_Click"/>
            <Button x:Name="DeleteButton" Content="Törlés" Padding="10,5" Margin="0,0,12,0" Click="DeleteButton_Click"/>
            <Button x:Name="MoveUpButton" Content="↑" ToolTip="Feljebb" Width="32" Padding="0,5" Margin="0,0,3,0" Click="MoveUpButton_Click"/>
            <Button x:Name="MoveDownButton" Content="↓" ToolTip="Lejjebb" Width="32" Padding="0,5" Margin="0,0,12,0" Click="MoveDownButton_Click"/>
            <Button x:Name="ConnectButton" Content="Csatlakozás" Padding="10,5" FontWeight="Bold" Click="ConnectButton_Click"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Margin="0,10,0,0" Foreground="Gray"/>

        <DataGrid x:Name="ConnectionsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  CanUserAddRows="False"
                  MouseDoubleClick="ConnectionsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Név" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Cím" Binding="{Binding DisplayTarget}" Width="200"/>
                <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="120"/>
                <DataGridTextColumn Header="Felhasználó" Binding="{Binding Username}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
